nded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#7f1d1d;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="470" height="90" as="geometry"/></mxCell><mxCell id="w-safe4" value="4. AI tắt / hết budget / lỗi&lt;br&gt;→ local search, task, reminder, moderation vẫn chạy" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#7c2d12;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="900" width="470" height="90" as="geometry"/></mxCell><mxCell id="w-safe5" value="5. MySQL commit trước embedding&lt;br&gt;→ API lỗi không mất dữ liệu sync" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#14532d;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="470" height="90" as="geometry"/></mxCell><mxCell id="w-safe6" value="6. Không xác minh admin / quyền Telegram&lt;br&gt;→ giữ tin, ghi audit fail-safe" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#7c2d12;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1030" width="470" height="90" as="geometry"/></mxCell><mxCell id="w-safe7" value="7. Telethon session rõ chỉ tồn tại khi chạy&lt;br&gt;→ mã hóa lại lúc shutdown" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#14532d;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="1160" width="470" height="90" as="geometry"/></mxCell><mxCell id="w-safe8" value="8. LOCAL ONLY&lt;br&gt;→ không fallback sang Cloud" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#7f1d1d;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1160" width="470" height="90" as="geometry"/></mxCell><mxCell id="w-shutdown-title" value="DỪNG HỆ THỐNG AN TOÀN" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=17;fontStyle=1;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1280" y="650" width="800" height="45" as="geometry"/></mxCell><mxCell id="w-signal" value="SIGINT / SIGTERM&lt;br&gt;stop.request / lỗi dừng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#ffedd5;strokeColor=#ea580c;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#7c2d12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="740" width="220" height="90" as="geometry"/></mxCell><mxCell id="w-cancel-tasks" value="Cancel task&lt;br&gt;dừng scheduler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="880" width="220" height="80" as="geometry"/></mxCell><mxCell id="w-close" value="Đóng bot · CoinGecko&lt;br&gt;Qdrant · database" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1010" width="220" height="85" as="geometry"/></mxCell><mxCell id="w-encrypt" value="Mã hóa lại&lt;br&gt;Telethon session" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#14532d;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1145" width="220" height="80" as="geometry"/></mxCell><mxCell id="w-clean" value="Xóa PID + started_at" style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y=