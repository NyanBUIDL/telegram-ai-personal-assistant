# Không đặt secret thật trong tệp này. Secret được nhập bằng
# `tg-assistant reconfigure` và lưu trong Windows Credential Manager.
TG_ASSISTANT_ENV=production
TG_ASSISTANT_TIMEZONE=Asia/Ho_Chi_Minh
TG_ASSISTANT_LOG_LEVEL=INFO
TG_ASSISTANT_ADMIN_API_ENABLED=true
TG_ASSISTANT_ADMIN_API_HOST=127.0.0.1
TG_ASSISTANT_ADMIN_API_PORT=8765
TG_ASSISTANT_ADMIN_SESSION_MINUTES=480
TG_ASSISTANT_DATA_DIR=./data
TG_ASSISTANT_LOG_DIR=./logs
TG_ASSISTANT_DATABASE_HOST=127.0.0.1
TG_ASSISTANT_DATABASE_PORT=3306
TG_ASSISTANT_DATABASE_NAME=telegram_ai_assistant
TG_ASSISTANT_DATABASE_USER=tg_assistant
TG_ASSISTANT_QDRANT_PATH=./data/qdrant
TG_ASSISTANT_QDRANT_VECTOR_SIZE=1536
TG_ASSISTANT_MEDIA_DOWNLOAD_ENABLED=false
TG_ASSISTANT_MEDIA_MAX_SIZE_MB=20
TG_ASSISTANT_DAILY_AI_BUDGET_USD=1.00
TG_ASSISTANT_MONTHLY_AI_BUDGET_USD=20.00
TG_ASSISTANT_MAX_INPUT_TOKENS_PER_REQUEST=12000
TG_ASSISTANT_MAX_OUTPUT_TOKENS_PER_REQUEST=3000
TG_ASSISTANT_MAX_AI_REQUESTS_PER_MINUTE=60
TG_ASSISTANT_LEARNING_JOB_INTERVAL_SECONDS=2
TG_ASSISTANT_ENABLE_DEEP_MODEL=false
TG_ASSISTANT_ENABLE_EMBEDDINGS=true
TG_ASSISTANT_AI_PROVIDER=openai
# Secret thật không nằm trong .env; các dòng SOURCE giúp xác nhận nơi lưu bền vững.
TG_ASSISTANT_OPENAI_API_KEY_SOURCE=windows_credential_manager
TG_ASSISTANT_OPENROUTER_API_KEY_SOURCE=windows_credential_manager
TG_ASSISTANT_COINGECKO_API_KEY_SOURCE=windows_credential_manager
TG_ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
TG_ASSISTANT_OPENAI_PRIMARY_MODEL=gpt-5.6-terra
TG_ASSISTANT_OPENAI_FAST_MODEL=gpt-5.6-luna
TG_ASSISTANT_OPENAI_DEEP_MODEL=gpt-5.6-sol
TG_ASSISTANT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TG_ASSISTANT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TG_ASSISTANT_OPENROUTER_PRIMARY_MODEL=openai/gpt-5.6-terra
TG_ASSISTANT_OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
TG_ASSISTANT_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
TG_ASSISTANT_OLLAMA_PRIMARY_MODEL=qwen3:8b
TG_ASSISTANT_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
TG_ASSISTANT_OLLAMA_VECTOR_SIZE=768
TG_ASSISTANT_OLLAMA_QDRANT_PATH=./data/qdrant_ollama
